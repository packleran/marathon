# Shared by both Railway services
DATABASE_URL=${{Postgres.DATABASE_URL}}
VITE_CONTENT_BACKEND=api

# Admin service
APP_ROLE=admin
VITE_APP_ROLE=admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
WHATSAPP_SEND_CREDENTIALS=true
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=student_login_details
WHATSAPP_TEMPLATE_LANGUAGE=he
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
MUX_ENV_KEY=
# Optional: pin direct uploads to one origin, for example https://admin.example.com
MUX_DIRECT_UPLOAD_CORS_ORIGIN=
# Optional: defaults to 4 hours and is extended automatically for longer videos
MUX_PLAYBACK_TOKEN_SECONDS=14400

